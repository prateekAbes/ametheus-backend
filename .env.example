# ==============================================================================
# AMETHEUS Esports Platform — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env in ametheus-backend/ and supply actual values.
# NEVER commit real credentials, passwords, or production secrets to git.
# ==============================================================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ametheus

# Authentication & Security
SECRET_KEY=ametheus_solar_vanguard_secure_key_2026
SUPER_ADMIN_EMAIL=admin@ametheus.gg
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_ISSUER=https://clerk.ametheus.gg

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://ametheus-frontend.vercel.app

# ==============================================================================
# EMAIL / BREVO SMTP
# ==============================================================================
  EMAIL_ENABLED=true

  # Brevo SMTP
  SMTP_HOST=smtp-relay.brevo.com
  SMTP_PORT=587
  SMTP_USERNAME=bb8902001@smtp-brevo.com
  SMTP_PASSWORD=
  SMTP_USE_TLS=true

  # Official sender
  OFFICIAL_EMAIL=official@ametheus.games
  OFFICIAL_EMAIL_NAME=Ametheus Official

  # Support sender
  SUPPORT_EMAIL=support@ametheus.games
  SUPPORT_EMAIL_NAME=Ametheus Support

  # Automated / no-reply sender
  NOREPLY_EMAIL=noreply@ametheus.games
  NOREPLY_EMAIL_NAME=Ametheus

  # Default reply-to address
  EMAIL_REPLY_TO=support@ametheus.games

# ==============================================================================
# RESEND INBOUND EMAIL CONFIGURATION (INBOUND REPLIES ONLY)
# ==============================================================================
# Brevo remains responsible for ALL outbound transactional and support emails.
# Resend is strictly used for receiving inbound email replies from users.

# Resend API Key: used to fetch full email body & attachments from Resend Receiving API
RESEND_API_KEY=

# Resend Webhook Secret: Svix signing secret (starts with whsec_...) used to verify inbound webhook signatures
RESEND_WEBHOOK_SECRET=

# Resend Technical Inbound Reply-To address (routes user replies to Resend inbound MX)
SUPPORT_INBOUND_EMAIL=support@inbound.ametheus.games
