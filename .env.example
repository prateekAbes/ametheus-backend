# AMETHEUS Esports Platform - Environment Template

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=ametheus

# SQL Database (for migration if needed)
DATABASE_URL=sqlite+aiosqlite:///./ametheus.db

# Authentication & Security
SECRET_KEY=your_secret_key_here
SUPER_ADMIN_EMAIL=admin@ametheus.gg
CLERK_ISSUER=https://clerk.ametheus.gg

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://ametheus-frontend.vercel.app

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_xxxxxx
RAZORPAY_KEY_SECRET=xxxxxx
