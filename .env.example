# ==============================================================================
# AMETHEUS Esports Platform — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env in ametheus-backend/ and supply actual values.
# NEVER commit real credentials, passwords, or production secrets to git.
# ==============================================================================

# Application
NODE_ENV=development
APP_NAME=Ametheus
APP_URL=https://ametheus.games
FRONTEND_URL=https://ametheus.games
BACKEND_URL=https://api.ametheus.games


# ==============================================================================
# DATABASE
# ==============================================================================

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ametheus


# ==============================================================================
# SECURITY
# ==============================================================================

SECRET_KEY=ametheus_solar_vanguard_secure_key_2026
ESCROW_SECRET_KEY=ametheus_escrow_vault_secret_2026
SUPER_ADMIN_EMAIL=admin@ametheus.gg


# ==============================================================================
# CLERK AUTHENTICATION
# ==============================================================================

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_ISSUER=https://clerk.ametheus.gg


# ==============================================================================
# CORS
# ==============================================================================

CORS_ORIGINS=https://ametheus.games,https://www.ametheus.games,https://ametheus-frontend.vercel.app,http://localhost:5173,http://localhost:3000


# ==============================================================================
# BREVO SMTP — OUTBOUND EMAIL
# ==============================================================================
# ALL outbound transactional email uses Brevo SMTP.
# Gmail SMTP is NOT used by Ametheus for transactional email.

EMAIL_ENABLED=true

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Brevo SMTP credentials (SMTP_USERNAME is the login address, SMTP_PASSWORD is the Brevo SMTP key)
SMTP_USERNAME=
SMTP_PASSWORD=


# ==============================================================================
# SENDER IDENTITIES (OUTBOUND)
# ==============================================================================

# --- Automated / No-Reply ---
# Used for: email verification, OTP, password reset, login alerts,
#           registration confirmations, payment confirmations, wallet notifications,
#           game registration notifications, system notifications.
# No Reply-To header is set for noreply emails.
NOREPLY_EMAIL=noreply@ametheus.games
NOREPLY_EMAIL_NAME=Ametheus

# --- Support ---
# From:     support@ametheus.games
# Reply-To: support@inbound.ametheus.games  (routes replies through Resend inbound)
SUPPORT_EMAIL=support@ametheus.games
SUPPORT_EMAIL_NAME=Ametheus Support
SUPPORT_INBOUND_EMAIL=support@inbound.ametheus.games

# Internal support desk notification recipient (admin alert on new ticket)
SUPPORT_ADMIN_EMAIL=support@tenetadmissions.com

# --- Official ---
# From:     official@ametheus.games
# Reply-To: OFFICIAL_REPLY_TO (set to official inbound Resend address if configured; leave blank if not yet configured)
OFFICIAL_EMAIL=official@ametheus.games
OFFICIAL_EMAIL_NAME=Ametheus
OFFICIAL_REPLY_TO=

# Default reply-to (legacy compatibility)
EMAIL_REPLY_TO=support@ametheus.games


# ==============================================================================
# RESEND — INBOUND EMAIL
# ==============================================================================
# Resend is used ONLY for receiving inbound email replies from users.
# Brevo is responsible for ALL outbound transactional and support email.
#
# User replies to support@ametheus.games route to support@inbound.ametheus.games
# via Resend inbound MX, then delivered via webhook to the Ametheus backend.

# Resend API Key: used to fetch full email body & attachments from Resend Receiving API
RESEND_API_KEY=

# Resend Webhook Secret: Svix signing secret (starts with whsec_...) for webhook signature verification
RESEND_WEBHOOK_SECRET=


# ==============================================================================
# PAYMENTS & WALLET
# ==============================================================================

# Add your payment gateway and wallet configuration here
# (preserved from existing project configuration)


# ==============================================================================
# GAMES & TOURNAMENTS
# ==============================================================================

# Add your game-specific and tournament configuration here
# (preserved from existing project configuration)


# ==============================================================================
# SUPPORT CONTACT
# ==============================================================================

SUPPORT_PHONE=+91 98765 43210
