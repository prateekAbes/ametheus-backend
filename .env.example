# ==============================================================================
# AMETHEUS Esports Platform — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your backend deployment directory and supply actual values.
# NEVER commit real credentials, passwords, or production secrets to version control.
# ==============================================================================

# ==========================================
# APPLICATION & SERVER
# ==========================================
# Application runtime environment: development, staging, or production
APP_ENV=development
# Server port for FastAPI uvicorn runner
PORT=8000
# Project display identifier
PROJECT_NAME="AMETHEUS Esports Engine"
# Versioned API path prefix
API_V1_STR=/api/v1

# ==========================================
# FRONTEND / BACKEND URLS
# ==========================================
# Public web URL of the Next.js frontend application
APP_URL=http://localhost:3000
# Accessible base URL of the FastAPI backend service
BACKEND_URL=http://localhost:8000

# ==========================================
# DATABASE (MongoDB & Legacy SQL)
# ==========================================
# Primary MongoDB connection URI (e.g. MongoDB Atlas cluster or local mongodb://localhost:27017)
MONGODB_URI=mongodb://localhost:27017
# Primary MongoDB database name
MONGODB_DB_NAME=ametheus
# Legacy / migration SQLite or PostgreSQL reference (handled by SQLAlchemy/aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./ametheus.db

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# Application JWT signing secret key (generate a 64+ char random secret in production)
SECRET_KEY=ametheus_solar_vanguard_secure_key_2026
# Initial super admin identity email recognized on bootstrap
SUPER_ADMIN_EMAIL=admin@ametheus.gg
# Clerk authentication issuer URL for JWKS token verification
CLERK_ISSUER=https://clerk.ametheus.gg
# Escrow HMAC vault encryption secret key
ESCROW_SECRET_KEY=ametheus_escrow_vault_secret_2026

# ==========================================
# CORS SETTINGS
# ==========================================
# Comma-separated list of allowed browser origins for cross-origin API requests
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://ametheus-frontend.vercel.app

# ==========================================
# DEFAULT EMAIL IDENTITIES (Admin-Configurable via DB)
# ==========================================
# The Super Admin can dynamically update these three identities in the Admin Cockpit without restarts.
# Official email for general business and formal communications
OFFICIAL_EMAIL=ametheus@gmail.com
# Public support contact email
SUPPORT_EMAIL=support@ametheus.gg
# Automated sender identity used in competition and system notifications
AUTOMATED_EMAIL=ametheus.noreply@gmail.com
# Recipient email for internal administrative support notifications
SUPPORT_ADMIN_EMAIL=ametheus.gg@gmail.com
# Support telephone line displayed on user-facing help panels
SUPPORT_PHONE="+91 98765 43210"

# ==========================================
# SMTP / EMAIL SERVICE (Backend Environment Only)
# ==========================================
# SMTP server hostname (e.g. smtp.gmail.com, email-smtp.us-east-1.amazonaws.com, smtp.sendgrid.net)
SMTP_HOST=
# SMTP server port: 587 (STARTTLS), 465 (SSL), or 25
SMTP_PORT=587
# SMTP relay username or account email
SMTP_USER=
# SMTP authentication password or App Password (NEVER expose to frontend or git)
SMTP_PASSWORD=
# Enable direct SSL/TLS socket connection (true for port 465, false for port 587 STARTTLS)
SMTP_SECURE=false
# Default fallback envelope sender address
SMTP_FROM_EMAIL=support@ametheus.gg
# Sender display name appearing in the From header of dispatched emails
SMTP_FROM_NAME="Ametheus Support Desk"

# ==========================================
# EXTERNAL PAYMENT GATEWAYS (Optional)
# ==========================================
# Razorpay Key ID for automated fiat payment verification
RAZORPAY_KEY_ID=
# Razorpay Key Secret (Server-side only)
RAZORPAY_KEY_SECRET=
