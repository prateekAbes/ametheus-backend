# ==============================================================================
# AMETHEUS Esports Platform — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env in ametheus-backend/ and supply actual values.
# NEVER commit real credentials, passwords, or production secrets to git.
# ==============================================================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ametheus

# Authentication & Security
SECRET_KEY=ametheus_solar_vanguard_secure_key_2026
SUPER_ADMIN_EMAIL=admin@ametheus.gg
CLERK_ISSUER=https://clerk.ametheus.gg

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://ametheus-frontend.vercel.app

# ==============================================================================
# Email Configuration (3 Gmail SMTP Identities)
# ==============================================================================
SUPPORT_EMAIL=support.ametheus@gmail.com
SUPPORT_SMTP_PASSWORD=your_support_gmail_app_password

NOREPLY_EMAIL=noreply.ametheus@gmail.com
NOREPLY_SMTP_PASSWORD=your_noreply_gmail_app_password

OFFICIAL_EMAIL=official.ametheus@gmail.com
OFFICIAL_SMTP_PASSWORD=your_official_gmail_app_password
